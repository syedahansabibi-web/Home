

<?php
declare(strict_types=1);

set_time_limit(300);

$url = trim($_POST['url'] ?? '');

if (!filter_var($url, FILTER_VALIDATE_URL)) {
    exit('Invalid website URL.');
}

$parts = parse_url($url);
if (!$parts || empty($parts['scheme']) || empty($parts['host'])) {
    exit('Invalid website URL.');
}

$scheme = strtolower($parts['scheme']);
if (!in_array($scheme, ['http', 'https'], true)) {
    exit('Only HTTP and HTTPS URLs are supported.');
}

$baseHost = strtolower($parts['host']);
$startUrl = $scheme . '://' . $baseHost . '/';

$queue = [$startUrl];
$visited = [];
$found = [];

function normalizeUrl(string $url): ?string {
    $p = parse_url($url);
    if (!$p || empty($p['host'])) return null;

    $scheme = strtolower($p['scheme'] ?? 'https');
    $host = strtolower($p['host']);
    $path = $p['path'] ?? '/';
    if ($path === '') $path = '/';

    // Ignore fragments.
    $normalized = $scheme . '://' . $host . $path;

    // Preserve a query only for non-empty, non-tracking queries.
    if (!empty($p['query'])) {
        parse_str($p['query'], $query);
        foreach (array_keys($query) as $key) {
            if (preg_match('/^(utm_|fbclid$|gclid$|msclkid$)/i', (string)$key)) {
                unset($query[$key]);
            }
        }
        if ($query) {
            $normalized .= '?' . http_build_query($query);
        }
    }

    return $normalized;
}

function fetchPage(string $url): array {
    $ch = curl_init($url);
    curl_setopt_array($ch, [
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_FOLLOWLOCATION => true,
        CURLOPT_MAXREDIRS => 5,
        CURLOPT_CONNECTTIMEOUT => 10,
        CURLOPT_TIMEOUT => 20,
        CURLOPT_USERAGENT => 'StandaloneSitemapGenerator/1.0',
        CURLOPT_HTTPHEADER => ['Accept: text/html,application/xhtml+xml'],
    ]);

    $body = curl_exec($ch);
    $status = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE);
    $type = (string)curl_getinfo($ch, CURLINFO_CONTENT_TYPE);
    $finalUrl = (string)curl_getinfo($ch, CURLINFO_EFFECTIVE_URL);
    curl_close($ch);

    return [$body ?: '', $status, $type, $finalUrl ?: $url];
}

while ($queue && count($visited) < 1000) {
    $current = array_shift($queue);
    $current = normalizeUrl($current);

    if (!$current || isset($visited[$current])) continue;
    $visited[$current] = true;

    [$html, $status, $contentType, $finalUrl] = fetchPage($current);

    if ($status < 200 || $status >= 300) continue;
    if (stripos($contentType, 'text/html') === false) continue;

    $normalizedFinal = normalizeUrl($finalUrl);
    if ($normalizedFinal) $found[$normalizedFinal] = true;

    libxml_use_internal_errors(true);
    $dom = new DOMDocument();
    if (@$dom->loadHTML($html)) {
        $links = $dom->getElementsByTagName('a');

        foreach ($links as $link) {
            $href = trim($link->getAttribute('href'));
            if ($href === '' || str_starts_with($href, '#')) continue;
            if (preg_match('/^(mailto:|tel:|javascript:|data:)/i', $href)) continue;

            $absolute = resolveUrl($current, $href);
            if (!$absolute) continue;

            $absolute = normalizeUrl($absolute);
            if (!$absolute) continue;

            $host = strtolower((string)parse_url($absolute, PHP_URL_HOST));
            if ($host !== $baseHost) continue;

            $path = strtolower((string)parse_url($absolute, PHP_URL_PATH));
            if (preg_match('/\.(jpg|jpeg|png|gif|webp|svg|pdf|zip|css|js|xml|json|mp4|mp3)$/i', $path)) {
                continue;
            }

            if (!isset($visited[$absolute]) && !in_array($absolute, $queue, true)) {
                $queue[] = $absolute;
            }
        }
    }
}

$urls = array_keys($found);
sort($urls);

$xml = new DOMDocument('1.0', 'UTF-8');
$xml->formatOutput = true;

$urlset = $xml->createElementNS(
    'http://www.sitemaps.org/schemas/sitemap/0.9',
    'urlset'
);
$xml->appendChild($urlset);

foreach ($urls as $pageUrl) {
    $urlNode = $xml->createElement('url');
    $loc = $xml->createElement('loc');
    $loc->appendChild($xml->createTextNode($pageUrl));
    $urlNode->appendChild($loc);
    $urlset->appendChild($urlNode);
}

$sitemapPath = __DIR__ . DIRECTORY_SEPARATOR . 'sitemap.xml';
$xml->save($sitemapPath);

?>
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Sitemap Created</title>
    <style>
        body { font-family: Arial, sans-serif; max-width: 760px; margin: 50px auto; padding: 20px; }
        .ok { padding: 15px; border: 1px solid #ccc; }
        code { background: #f3f3f3; padding: 2px 5px; }
    </style>
</head>
<body>
    <h1>Sitemap created</h1>
    <div class="ok">
        <p><strong><?= count($urls) ?></strong> same-domain HTML pages were found.</p>
        <p>File created: <code>sitemap.xml</code></p>
        <p><a href="sitemap.xml" target="_blank">Open sitemap.xml</a></p>
    </div>
    <p><a href="index.php">Generate another sitemap</a></p>
</body>
</html>
<?php

function resolveUrl(string $base, string $relative): ?string {
    if (filter_var($relative, FILTER_VALIDATE_URL)) {
        return $relative;
    }

    $bp = parse_url($base);
    if (!$bp || empty($bp['scheme']) || empty($bp['host'])) return null;

    if (str_starts_with($relative, '//')) {
        return $bp['scheme'] . ':' . $relative;
    }

    if (str_starts_with($relative, '/')) {
        return $bp['scheme'] . '://' . $bp['host'] . $relative;
    }

    $basePath = $bp['path'] ?? '/';
    $dir = rtrim(str_replace('\\', '/', dirname($basePath)), '/');
    $path = ($dir === '' ? '' : $dir) . '/' . $relative;

    // Resolve "." and ".."
    $segments = [];
    foreach (explode('/', $path) as $segment) {
        if ($segment === '' || $segment === '.') continue;
        if ($segment === '..') {
            array_pop($segments);
        } else {
            $segments[] = $segment;
        }
    }

    return $bp['scheme'] . '://' . $bp['host'] . '/' . implode('/', $segments);
}
?>
